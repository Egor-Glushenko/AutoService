<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.autoservice.fx.ui.controller.MainController"
            styleClass="app-root">

    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="16">
            <VBox HBox.hgrow="ALWAYS" spacing="2">
                <Label text="Автосервис" styleClass="app-title"/>
                <Label text="Учёт заказ-нарядов на ремонт и обслуживание автомобилей" styleClass="app-subtitle"/>
            </VBox>
            <Label fx:id="connectionLabel" styleClass="badge"/>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Заказ-наряды">
                <VBox styleClass="content" spacing="10">

                    <HBox styleClass="toolbar" spacing="8" alignment="CENTER_LEFT">
                        <Button text="＋ Добавить" onAction="#onAdd" styleClass="primary"/>
                        <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
                        <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="danger"/>
                        <Separator orientation="VERTICAL"/>
                        <Button text="⟳ Обновить" onAction="#onRefresh"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Button text="Статистика" onAction="#onStatistics"/>
                        <Button text="Экспорт в CSV" onAction="#onExport"/>
                    </HBox>

                    <FlowPane styleClass="filter-bar" hgap="10" vgap="8">
                        <TextField fx:id="searchField" prefWidth="340"
                                   promptText="Поиск: номер, клиент, телефон, авто, госномер, механик, работы"/>
                        <ComboBox fx:id="statusFilter" prefWidth="150"/>
                        <ComboBox fx:id="mechanicFilter" prefWidth="170"/>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Приём с" styleClass="filter-label"/>
                            <DatePicker fx:id="fromDatePicker" prefWidth="130" promptText="ДД.ММ.ГГГГ"/>
                            <Label text="по" styleClass="filter-label"/>
                            <DatePicker fx:id="toDatePicker" prefWidth="130" promptText="ДД.ММ.ГГГГ"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="Сортировка" styleClass="filter-label"/>
                            <ComboBox fx:id="sortCombo" prefWidth="230"/>
                        </HBox>
                        <Button text="Сбросить" onAction="#onResetFilters" styleClass="flat"/>
                    </FlowPane>

                    <SplitPane dividerPositions="0.73" VBox.vgrow="ALWAYS">
                        <TableView fx:id="ordersTable">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                            <placeholder>
                                <Label text="Нет заказ-нарядов, удовлетворяющих условиям поиска"/>
                            </placeholder>
                            <columns>
                                <TableColumn fx:id="numberColumn" text="Номер" prefWidth="80"/>
                                <TableColumn fx:id="createdColumn" text="Приём" prefWidth="90"/>
                                <TableColumn fx:id="clientColumn" text="Клиент" prefWidth="190"/>
                                <TableColumn fx:id="carColumn" text="Автомобиль" prefWidth="130"/>
                                <TableColumn fx:id="plateColumn" text="Госномер" prefWidth="95"/>
                                <TableColumn fx:id="mechanicColumn" text="Механик" prefWidth="130"/>
                                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="95"/>
                                <TableColumn fx:id="costColumn" text="Стоимость" prefWidth="110" styleClass="numeric"/>
                                <TableColumn fx:id="completedColumn" text="Выдача" prefWidth="90"/>
                            </columns>
                        </TableView>

                        <ScrollPane fitToWidth="true" styleClass="details-scroll" minWidth="260">
                            <VBox styleClass="details-pane" spacing="10">
                                <Label text="Карточка заказа" styleClass="section-title"/>
                                <Label fx:id="detailsHint" wrapText="true" styleClass="muted"
                                       text="Выберите заказ-наряд в таблице, чтобы увидеть клиента, автомобиль и механика. Двойной щелчок открывает редактирование."/>
                                <GridPane fx:id="detailsGrid" hgap="10" vgap="6" styleClass="details-grid">
                                    <columnConstraints>
                                        <ColumnConstraints minWidth="95"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>
                                    <Label text="Заказ" styleClass="details-group" GridPane.rowIndex="0" GridPane.columnSpan="2"/>
                                    <Label text="Номер" styleClass="details-key" GridPane.rowIndex="1"/>
                                    <Label fx:id="detailNumber" styleClass="details-value" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                    <Label text="Статус" styleClass="details-key" GridPane.rowIndex="2"/>
                                    <Label fx:id="detailStatus" styleClass="details-value" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                                    <Label text="Приём" styleClass="details-key" GridPane.rowIndex="3"/>
                                    <Label fx:id="detailCreated" styleClass="details-value" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                                    <Label text="Выдача" styleClass="details-key" GridPane.rowIndex="4"/>
                                    <Label fx:id="detailCompleted" styleClass="details-value" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                                    <Label text="Срок" styleClass="details-key" GridPane.rowIndex="5"/>
                                    <Label fx:id="detailDuration" styleClass="details-value" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                                    <Label text="Стоимость" styleClass="details-key" GridPane.rowIndex="6"/>
                                    <Label fx:id="detailCost" styleClass="details-value" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                                    <Label text="Клиент" styleClass="details-group" GridPane.rowIndex="7" GridPane.columnSpan="2"/>
                                    <Label text="ФИО" styleClass="details-key" GridPane.rowIndex="8"/>
                                    <Label fx:id="detailClient" styleClass="details-value" wrapText="true" GridPane.rowIndex="8" GridPane.columnIndex="1"/>
                                    <Label text="Телефон" styleClass="details-key" GridPane.rowIndex="9"/>
                                    <Label fx:id="detailPhone" styleClass="details-value" GridPane.rowIndex="9" GridPane.columnIndex="1"/>

                                    <Label text="Автомобиль" styleClass="details-group" GridPane.rowIndex="10" GridPane.columnSpan="2"/>
                                    <Label text="Модель" styleClass="details-key" GridPane.rowIndex="11"/>
                                    <Label fx:id="detailCar" styleClass="details-value" GridPane.rowIndex="11" GridPane.columnIndex="1"/>
                                    <Label text="Год" styleClass="details-key" GridPane.rowIndex="12"/>
                                    <Label fx:id="detailYear" styleClass="details-value" GridPane.rowIndex="12" GridPane.columnIndex="1"/>
                                    <Label text="Госномер" styleClass="details-key" GridPane.rowIndex="13"/>
                                    <Label fx:id="detailPlate" styleClass="details-value" GridPane.rowIndex="13" GridPane.columnIndex="1"/>

                                    <Label text="Механик" styleClass="details-group" GridPane.rowIndex="14" GridPane.columnSpan="2"/>
                                    <Label text="ФИО" styleClass="details-key" GridPane.rowIndex="15"/>
                                    <Label fx:id="detailMechanic" styleClass="details-value" wrapText="true" GridPane.rowIndex="15" GridPane.columnIndex="1"/>
                                    <Label text="Профиль" styleClass="details-key" GridPane.rowIndex="16"/>
                                    <Label fx:id="detailSpecialization" styleClass="details-value" wrapText="true" GridPane.rowIndex="16" GridPane.columnIndex="1"/>

                                    <Label text="Описание работ" styleClass="details-group" GridPane.rowIndex="17" GridPane.columnSpan="2"/>
                                    <Label fx:id="detailDescription" styleClass="details-value" wrapText="true"
                                           GridPane.rowIndex="18" GridPane.columnSpan="2"/>
                                </GridPane>
                            </VBox>
                        </ScrollPane>
                    </SplitPane>

                    <Label fx:id="countLabel" styleClass="status-bar"/>
                </VBox>
            </Tab>

            <Tab text="Клиенты и автомобили">
                <SplitPane dividerPositions="0.6" styleClass="content">
                    <VBox spacing="8">
                        <padding><Insets right="8"/></padding>
                        <Label text="Клиенты" styleClass="section-title"/>
                        <TableView fx:id="clientsTable" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                            <placeholder><Label text="Клиентов нет"/></placeholder>
                            <columns>
                                <TableColumn fx:id="clientNameColumn" text="ФИО" prefWidth="230"/>
                                <TableColumn fx:id="clientPhoneColumn" text="Телефон" prefWidth="130"/>
                                <TableColumn fx:id="clientEmailColumn" text="E-mail" prefWidth="170"/>
                                <TableColumn fx:id="clientCarsColumn" text="Авто" prefWidth="60" styleClass="numeric"/>
                                <TableColumn fx:id="clientOrdersColumn" text="Заказов" prefWidth="70" styleClass="numeric"/>
                            </columns>
                        </TableView>
                    </VBox>
                    <VBox spacing="8">
                        <padding><Insets left="8"/></padding>
                        <Label fx:id="carsTitle" text="Автомобили клиента" styleClass="section-title"/>
                        <TableView fx:id="carsTable" VBox.vgrow="ALWAYS">
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                            <placeholder><Label text="Выберите клиента слева"/></placeholder>
                            <columns>
                                <TableColumn fx:id="carBrandColumn" text="Марка" prefWidth="110"/>
                                <TableColumn fx:id="carModelColumn" text="Модель" prefWidth="110"/>
                                <TableColumn fx:id="carYearColumn" text="Год" prefWidth="60" styleClass="numeric"/>
                                <TableColumn fx:id="carPlateColumn" text="Госномер" prefWidth="110"/>
                            </columns>
                        </TableView>
                    </VBox>
                </SplitPane>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
