<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.autoservice.fx.ui.controller.OrderFormController"
      styleClass="form-root" spacing="14" prefWidth="580">

    <Label fx:id="formTitle" styleClass="form-title"/>
    <Label text="Поля, отмеченные *, обязательны для заполнения." styleClass="muted"/>

    <GridPane styleClass="form-grid" hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Номер *" GridPane.rowIndex="0"/>
        <TextField fx:id="numberField" promptText="ЗН-0001" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Автомобиль *" GridPane.rowIndex="1"/>
        <ComboBox fx:id="carCombo" maxWidth="Infinity" promptText="Выберите автомобиль клиента"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Механик *" GridPane.rowIndex="2"/>
        <ComboBox fx:id="mechanicCombo" maxWidth="Infinity" promptText="Выберите механика"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Статус *" GridPane.rowIndex="3"/>
        <ComboBox fx:id="statusCombo" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Дата приёма *" GridPane.rowIndex="4"/>
        <DatePicker fx:id="createdPicker" maxWidth="Infinity" promptText="ДД.ММ.ГГГГ"
                    GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Дата выдачи" GridPane.rowIndex="5"/>
        <DatePicker fx:id="completedPicker" maxWidth="Infinity"
                    promptText="Для выполненного или отменённого заказа"
                    GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Стоимость, ₽ *" GridPane.rowIndex="6"/>
        <TextField fx:id="costField" promptText="Например, 12500 или 12500,50"
                   GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Описание работ *" GridPane.rowIndex="7" GridPane.valignment="TOP"/>
        <VBox spacing="4" GridPane.rowIndex="7" GridPane.columnIndex="1">
            <TextArea fx:id="descriptionArea" prefRowCount="4" wrapText="true"
                      promptText="Что нужно сделать с автомобилем"/>
            <Label fx:id="descriptionCounter" styleClass="muted"/>
        </VBox>
    </GridPane>

    <VBox fx:id="errorBox" styleClass="error-box">
        <Label text="Исправьте ошибки:" styleClass="error-title"/>
        <Label fx:id="errorLabel" wrapText="true"/>
    </VBox>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="Отмена" onAction="#onCancel" cancelButton="true"/>
        <Button text="Сохранить" onAction="#onSave" defaultButton="true" styleClass="primary"/>
    </HBox>
</VBox>
